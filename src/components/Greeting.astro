---
import { Image } from "astro:assets";
import selfie from "@images/me.jpg";
import { site } from "@config";

const { profile } = site
const formatter = new Intl.ListFormat("en", {
  style: "long",
  type: "conjunction",
});
const formattedInterests = formatter.format(profile.interests);
---

<div class="container">
  <div class="hero-text">
    <h2>{profile.header}</h2>
    <p>{profile.welcome}</p>
    <p>{profile.bio} I like {formattedInterests}.</p>
  </div>
  <Image src={selfie} alt="Orion Anderson" width={230} height={230} priority />
</div>

<style>
  .container {
    padding-bottom: 2rem;
    display: flex;
    flex-direction: column;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-box-border);
  }
  h2 {
    margin-top: 0;
    color: var(--color-text-base);
  }
  img {
    border-radius: 0.3rem;
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .container {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--color-box-border);
    }
    img {
      margin-left: 2rem;
      width: 230px;
      height: 230px;
    }
  }
</style>
