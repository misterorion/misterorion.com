---
import { site } from "@config";
import ThemeToggle from "@components/ThemeToggle.astro";

const { userFirstName, userLastName, mainMenu } = site;
---

<header class="header-container">
  <div class="header-bar">
    <a href="/" class="site-title" aria-label="Home">
      <span class="text-pink">{userFirstName.toLowerCase()}</span>
      <span class="text-teal">{userLastName.toLowerCase()}</span>
    </a>

    <div class="header-actions">
      <div class="theme-toggle-mobile">
        <ThemeToggle />
      </div>
      <button
        class="hamburger"
        id="hamburger"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="main-nav" aria-label="Main navigation">
    {
      mainMenu.map((item) => (
        <a href={item.slug} class="nav-link">
          {item.name}
        </a>
      ))
    }
    <div class="theme-toggle-desktop">
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const hamburger = document.getElementById("hamburger");
  const nav = document.getElementById("main-nav");

  if (hamburger && nav) {
    hamburger.addEventListener("click", () => {
      const isExpanded = hamburger.getAttribute("aria-expanded") === "true";
      hamburger.setAttribute("aria-expanded", (!isExpanded).toString());
      hamburger.classList.toggle("active");
      nav.classList.toggle("active");
    });

    // Close menu when clicking a link
    nav.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest(".nav-link")) {
        hamburger.setAttribute("aria-expanded", "false");
        hamburger.classList.remove("active");
        nav.classList.remove("active");
      }
    });
  }
</script>

<style>
  .header-container {
    margin-bottom: 4.5rem;
    font-family: "Quicksand Variable", sans-serif;
  }
  .header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 1rem;
  }
  .site-title {
    display: flex;
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--color-text-base);
    text-decoration: none;
  }
  .site-title::before {
    content: "<";
    margin-right: 8px;
  }
  .site-title::after {
    content: ">";
    margin-left: 8px;
  }
  .site-title::before,
  .site-title::after {
    font-size: 1.6rem;
    position: relative;
    top: 2px;
  }
  .text-pink {
    color: var(--color-highlight);
  }
  .text-teal {
    color: var(--color-accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1000;
    min-width: 40px;
    min-height: 40px;
  }
  .hamburger span {
    display: block;
    width: 25px;
    height: 3px;
    background-color: var(--color-text-base);
    transition: all 0.3s ease;
  }
  .hamburger.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  #main-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.3s ease,
      padding 0.3s ease;
  }
  #main-nav.active {
    max-height: 500px;
    padding-top: 1rem;
  }
  .nav-link {
    font-size: 1.125rem;
    font-weight: 700;
    border-radius: 0.25rem;
    background-color: var(--color-neutral);
    padding: 0.25rem 0.5rem;
    text-align: center;
    text-decoration: none;
    color: var(--color-text-contrast);
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-link:hover {
    color: var(--color-highlight);
  }
  .theme-toggle-desktop {
    display: none;
  }
  .theme-toggle-mobile {
    display: flex;
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    .hamburger {
      display: none;
    }
    .header-container {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      padding-top: 1.5rem;
    }
    #main-nav {
      flex-direction: row;
      max-height: none;
      overflow: visible;
      padding-top: 0;
      align-items: center;
      margin-top: 1rem;
      gap: 0;
    }
    .nav-link {
      margin-left: 1rem;
      /* text-align: left; */
    }
    .nav-link:first-child {
      margin-left: 0;
    }
    .site-title {
      font-size: 1.875rem;
    }
    .site-title::before,
    .site-title::after {
      font-size: 2rem;
      top: 2px;
    }
    .theme-toggle-desktop {
      display: flex;
    }
    .theme-toggle-mobile {
      display: none;
    }
  }
</style>
