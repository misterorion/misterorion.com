---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { site } from "@config";

const games = await getCollection("gg");
const pageTitle = `${site.title} - GG`;
const pageDescription = "My gaming love. My gaming life.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div id="gg">
    <p>{pageDescription}</p>
    <h2>All Games</h2>
    <div class="entry-list">
      {
        games.map(({ id, data }) => (
          <div class="row">
            <a href={`/gg/${id}/`} class="title">
              {data.title}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
