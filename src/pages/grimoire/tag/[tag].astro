---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { site } from "@config";
import { render } from "astro:content";
import { slugify } from "@utils";

export const getStaticPaths = (async () => {
  const allEntries = await getCollection("grimoire");

  // 1. Normalize tags to handle case sensitivity issues
  const uniqueTags = [...new Set(allEntries.flatMap((e) => e.data.tags))];

  return uniqueTags.map((tag) => {
    // 2. Filter entries for this specific tag
    const filteredEntries = allEntries.filter((e) => e.data.tags.includes(tag));

    return {
      params: { tag: slugify(tag) },
      props: {
        tag,
        entries: filteredEntries,
      },
    };
  });
}) satisfies GetStaticPaths;

const { entries, tag } = Astro.props;

// 3. Pre-render all content in parallel for better performance
const renderedEntries = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { ...entry, Content };
  })
);

const pageTitle = `${tag} | ${site.title}`;
---

<Layout title={pageTitle}>
  <h1>Grimoire Entries tagged with "{tag}"</h1>

  {
    renderedEntries.map(({ data, Content }) => (
      <h2>{data.title}</h2>
      <Content />
    ))
  }
</Layout>
