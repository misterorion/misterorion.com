---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { site } from "@config";
import { slugify } from "@utils";

const entries = await getCollection("grimoire");
const pageTitle = `${site.title} - Grimoire`;
const pageDescription =
  "Wherein I record knowledge of a technical nature for future reference.";
---

<Layout title={pageTitle} description={pageDescription}>
  <p>
    <strong>Grimoire</strong>
    &nbsp;&nbsp;&nbsp;/grəm-wär&#39;/&nbsp;&nbsp;&nbsp;
    <strong>▶&nbsp;&nbsp;&nbsp;noun</strong>
    &nbsp;&nbsp;&nbsp;A book of magical knowledge.
  </p>
  <p>Wherein I record knowledge of a technical nature for future reference.</p>
  <h2>All Entries</h2>
  <div class="entry-list">
    {
      entries.map(({ id, data  }) => (
        <div class="row">
          <a
            href={`/grimoire/${id}/`}
            class="title"
          >
            {data.title}
          </a>
          <div class="tag-list">
            <span class="arrow">▶</span>
            {data.tags.map((tag) => (
              <a
                href={`/grimoire/tag/${slugify(tag)}/`}
                class="tag-style"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Layout>

<style>
  .excerpt {
    display: inline;
    font-style: italic;
  }
  .title {
    font-weight: 700;
    text-decoration: none;
    flex-grow: 1;
    color: var(--color-highlight);
  }
  .title:hover {
    text-decoration: underline;
  }
  .arrow {
    color: var(--color-accent);
    margin-right: 1rem;
    margin-left: 0;
  }
  .tag-style {
    font-family: "Quicksand Variable", sans-serif;
    display: inline-block;
    background-color: var(--color-neutral);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    margin-right: 0.5rem;
    color: var(--color-text-contrast);
  }
  .tag-style:hover {
    color: var(--color-highlight);
    transform: rotate(-2deg) translateY(-2px);
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
  .tag-style:hover:nth-child(odd) {
    transform: rotate(2deg) translateY(-2px);
  }

  @media screen and (min-width: 1024px) {
    .arrow {
      margin-right: 1rem;
      margin-left: 1rem;
    }
  }
</style>
